NODE_ENV=development
PORT=3000

# Must exactly match your deployed frontend origin (scheme + host, no trailing slash).
# Comma-separate multiple origins if needed.
FRONTEND_URL=https://your-frontend.example.com

# Cookie SameSite for refresh token. Use "none" for cross-origin frontend + API deploys.
# Defaults to "none" in production and "lax" in development.
# COOKIE_SAME_SITE=none

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
DATABASE_URL=
