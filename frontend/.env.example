# Dev: use Vite proxy by leaving API URL empty, or point at local backend.
# VITE_API_BASE_URL=
VITE_API_BASE_URL=http://localhost:3000

# Production: full HTTPS API URL (must match backend CORS FRONTEND_URL origin).
# VITE_API_BASE_URL=https://your-api.example.com

# Socket server (same host as API in dev)
VITE_SOCKET_URL=http://localhost:3000
